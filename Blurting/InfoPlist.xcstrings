  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank Page Recall"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白纸回忆"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白紙回憶"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan notes or compare a photo of your handwritten recall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍照导入讲义，或拍下纸上默写内容进行对照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於拍照匯入講義，或拍下紙上默寫內容進行對照。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos already on your device to compare handwritten recall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于选择已在本机的照片，对照纸上默写内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於選擇已在本機的照片，對照紙上默寫內容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
