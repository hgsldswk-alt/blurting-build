    "example.answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photosynthesis absorbs CO₂. Carbon moves through food webs. Respiration releases it. Oceans absorb and release CO₂. Some stays dissolved. Sediment, soil and rock store carbon. Fossil fuels and fires release it. Deforestation reduces uptake. Volcanoes emit CO₂. Coal, oil and gas store old carbon, methane moves it to the air, and peat holds it. Planting trees can increase storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光合作用吸收二氧化碳，碳沿食物网传递，呼吸释放二氧化碳。海洋吸收和释放二氧化碳，一部分碳溶在海水中。沉积物、土壤和岩石都能储碳。燃烧化石燃料和野火释放碳。砍伐森林会减少吸收。火山会放出二氧化碳，煤、石油和天然气储存古老的碳。甲烷携碳进入空气，泥炭也能积累碳。植树能增加碳储量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光合作用吸收二氧化碳，碳沿食物網傳遞，呼吸釋放二氧化碳。海洋吸收和釋放二氧化碳，一部分碳溶在海水中。沉積物、土壤和岩石都能儲碳。燃燒化石燃料和野火釋放碳。砍伐森林會減少吸收。火山會放出二氧化碳，煤、石油和天然氣儲存古老的碳。甲烷攜碳進入空氣，泥炭也能累積碳。植樹能增加碳儲量。"
          }
        }
      }
    },
    "example.point.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plants absorb CO₂ through photosynthesis."
